import datetime
import json

## place to hold the data
todo_list = []

# create a structure to store description , is_complete , date_created

class Todo_Item:
    description = ""
    is_complete = False
    date_created = ""

def load_data ():
    with open("json_string.json", "r") as file:
        json_string = json.load(file)
        temp_dict = json.loads(json_string)
        for item in temp_dict:
            todo_item = Todo_Item()
            todo_item.description = item['description']
            todo_item.is_complete = item['is_complete']
            todo_item.date_created = item['date_created']
            globals()['todo_list'].append(todo_item)

def save_data():
    json_string = json.dumps([todo.__dict__ for todo in todo_list], indent=4)
    print(json_string)

    with open("json_string.json", "w") as file:
        json.dump(json_string, file, indent=4)
    print("Saved to JSON!")

def print_menu():
    print('''menu:- print all the commands
print:- print the list
add:- add an item
quit:- quit this program
delete:- delete an item''')

def add_item():
    myTodo = Todo_Item()
    # accept input
    todo_item = input("Enter your todo item:")
    myTodo.description = todo_item
    myTodo.is_complete = False
    myTodo.date_created = datetime.datetime.now().isoformat()
    # store it into todo_list
    todo_list.append(myTodo)
    # print todo_list
    print_todo_list(todo_list)

def delete_item():
    for i, todo in enumerate(todo_list, start=1):
        print(f"{i}. {todo.description}")

    # Getting user input
    user_input = int(input("Enter the number of the task to delete: "))

    # Adjusting for 0-based indexing
    index_to_delete = user_input - 1

    # Deleting the item safely
    if 0 <= index_to_delete < len(todo_list):
        removed_task = todo_list.pop(index_to_delete)
        print(f"Successfully deleted: '{removed_task}'")
    else:
        print("Invalid task number!") 

def main ():
    load_data()
    # print todo_list
    #print(todo_list)
    print("Welcome to Todo App")
    print_menu()
# loop throgh a command prompt to accept input and add the todo item

    command = "something"
    while command != "no":
        command = input("Enter your command:")
        if command == "menu":
            print_menu()
        elif command == "add":
            add_item()
        elif command == "print":
            print_todo_list(todo_list)
        elif command == "delete":
            delete_item() 
        elif command == "quit":
            break

    # save data and exit the program
    save_data()


def print_todo_list(list):

    print(len(list), " items found in the list..\n")

    for item in list:
        print("-> ", item.description, " Completed: ", item.is_complete , " Created: ", item.date_created)


main()
print("Bye")
